aws_region  = "us-east-2"
environment = "homolog"
project     = "fiap-officine"

# OS Service (dono da base de clientes) — a Lambda não acessa mais o RDS
os_service_url     = "https://<api-gateway-id>.execute-api.us-east-2.amazonaws.com"
internal_api_token = "<mesmo INTERNAL_API_TOKEN do os-service>"

# Segredo JWT compartilhado com o backend
jwt_secret_key     = "fiap-officine-super-secret-jwt-key-change-in-prod"
jwt_algorithm      = "HS256"
jwt_expire_minutes = 60

# VPC e Subnets (opcional; sem NAT a Lambda em VPC não alcança o OS Service)
# vpc_id             = "vpc-0123456789abcdef0"
# subnet_ids         = ["subnet-0123456789abcdef1", "subnet-0123456789abcdef2"]
# security_group_ids = ["sg-0123456789abcdef3"]
